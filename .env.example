# Google Sheets CMS — see README "Google Sheets CMS".
# CMS_URL is the Apps Script web-app URL (Deploy → Web app → …/exec).
# CMS_TOKEN comes from the sheet menu CA³ CMS → Set API token…
CMS_URL=
CMS_TOKEN=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty for no analytics and no cookie banner.
PUBLIC_GA_ID=
# Optional: privacy policy the cookie banner links to.
PUBLIC_PRIVACY_URL=
