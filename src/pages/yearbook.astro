---
import Base from "../layouts/Base.astro";
import SearchMeta from "../components/SearchMeta.astro";
import { yearbook } from "../lib/data";

/* one section per year — the yearly retreat, conferences, other moments — each with a
   photo, a few lines, and up to three more photos */
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
---
<Base title="Yearbook · CA³" description="The CA³ year in pictures: our yearly research retreat and the conferences we travel to." current="/yearbook/">
  <SearchMeta kind="Page" />
  <div class="wrap">
    <div class="pagehero">
      <div>
        <h1>Yearbook</h1>
        <p class="lead" style="margin-top:20px;max-width:46ch">Our year in pictures: the retreat where the whole centre leaves the office for a few days, and the conferences we travel to.</p>
        <nav class="yearjump" aria-label="Years">{yearbook.map((y) => <a class="chip" href={"#y" + y.year}>{y.year}</a>)}</nav>
      </div>
    </div>

    {yearbook.map((y) => (
      <section class="yb" id={"y" + y.year}>
        <div class="yb-side"><div class="yb-year">{y.year}</div></div>
        <div class="yb-main">
          {y.entries.map((e) => {
            const extras = e.photos.filter(Boolean).slice(0, 3);
            return (
              <article class="yb-entry" id={y.year + "-" + slug(e.kind + " " + e.title)}>
                <h2 class="yb-title">{e.title}</h2>
                {(e.place || e.when || e.link || e.draft) && (
                  <div class="yb-meta">
                    {(e.place || e.when) && <span class="small">{[e.place, e.when].filter(Boolean).join(" · ")}</span>}
                    {e.link && <a class="small" href={e.link} target="_blank" rel="noreferrer">{new URL(e.link).hostname.replace(/^www\./, "")} ↗</a>}
                    {e.draft && <span class="yb-draft">Placeholder</span>}
                  </div>
                )}
                <div class={"yb-photo ph" + (e.photo ? " has" : "")}>
                  {e.photo ? <img src={e.photo} alt={`${e.title}, ${y.year}`} loading="lazy" /> : <span>{e.kind} photo — {y.year}</span>}
                </div>
                <p class="yb-text">{e.text}</p>
                {extras.length > 0 && <div class="yb-extras">{extras.map((src: string) => <div class="ph has"><img src={src} alt="" loading="lazy" /></div>)}</div>}
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>
